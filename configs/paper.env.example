# Copy to configs/paper.env, edit the local paths, then run:
#   source configs/paper.env

export SD_PATH="/path/to/sd-turbo"
export ELIC_PATH="/path/to/elic_official.pth"
export TRAIN_H5="/path/to/USOD10K_train.hdf5"
export TRAIN_RGB_DEPTH_H5="/path/to/USOD10K_train_rgb_depth.hdf5"
export VAL_IMAGE_DIR="/path/to/USOD10K/VAL"
export VAL_DEPTH_DIR="/path/to/USOD10K/VAL/depth"
export OUTPUT_ROOT="/path/to/paper_outputs"

# Frozen task-feature supervisors used in Stage 2.
export FATHOMNET_YOLO_PATH="/path/to/mbari-megalodon-yolo11x.pt"
export TCUSOD_CHECKPOINT="/path/to/TC_USOD.pth"
export TCUSOD_REPO_ROOT="/path/to/USOD10K-main"

# Frozen DINOv2 backbone used by the Stage-2 vision-aided discriminator.
export DINOV2_REPO_PATH="/path/to/dinov2"

# Independent U2-Net model used only for the reported saliency evaluation.
export U2NET_CHECKPOINT="/path/to/u2net.pth"
export U2NET_REPO_ROOT="/path/to/U-2-Net"

# Optional; paper_common.sh defaults to GPU 0.
export CUDA_VISIBLE_DEVICES="0"
export PAPER_SEED="2026"

